# Server
PORT=5000

# Comma-separated list of allowed CORS origins.
# Leave empty to allow all origins (handy locally).
CORS_ORIGINS=http://localhost:3000

# Database connection. Either set DATABASE_URL OR the individual vars.
# Railway: paste the MySQL connection URL from your provisioned database.
DATABASE_URL=mysql://user:password@host:3306/database

# Used as a fallback when DATABASE_URL is not set
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=earnest

# Set DATABASE_SSL=true for hosted MySQL providers that require TLS.
DATABASE_SSL=false
# Optional: paste a provider CA certificate here using \n for line breaks.
DATABASE_SSL_CA=
# Only use true if your provider requires SSL but does not provide a CA certificate.
DATABASE_SSL_ALLOW_UNAUTHORIZED=false

# JWT secrets — use long random strings in production.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
