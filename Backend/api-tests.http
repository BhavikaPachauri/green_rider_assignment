@baseUrl = http://localhost:5000
@name = Demo User
@email = demo@example.com
@password = secret123
@role = ADMIN
@accessToken =
@refreshToken =
@projectId = 1
@taskId = 1
@memberEmail = teammate@example.com

### Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "{{name}}",
  "email": "{{email}}",
  "password": "{{password}}",
  "role": "{{role}}"
}

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

### Current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### Refresh token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

### Logout
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Create project
# @name createProject
POST {{baseUrl}}/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Marketing Site",
  "description": "Q2 launch project"
}

> {%
  client.global.set("projectId", response.body.id);
%}

### List projects
GET {{baseUrl}}/projects
Authorization: Bearer {{accessToken}}

### Project detail
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{accessToken}}

### Update project
PATCH {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Marketing Site (renamed)"
}

### Add member
POST {{baseUrl}}/projects/{{projectId}}/members
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "email": "{{memberEmail}}"
}

### Create task
# @name createTask
POST {{baseUrl}}/tasks
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Outline landing page",
  "description": "Hero copy + CTA",
  "projectId": {{projectId}},
  "status": "TODO",
  "dueDate": "2026-06-01"
}

> {%
  client.global.set("taskId", response.body.id);
%}

### List tasks
GET {{baseUrl}}/tasks?page=1&limit=10
Authorization: Bearer {{accessToken}}

### List overdue tasks
GET {{baseUrl}}/tasks?overdue=true
Authorization: Bearer {{accessToken}}

### Tasks assigned to me
GET {{baseUrl}}/tasks?mine=true
Authorization: Bearer {{accessToken}}

### Update task status
PATCH {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "IN_PROGRESS"
}

### Delete task
DELETE {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}

### Dashboard summary
GET {{baseUrl}}/dashboard/summary
Authorization: Bearer {{accessToken}}

### Search users
GET {{baseUrl}}/users?search=demo
Authorization: Bearer {{accessToken}}
